# Docker 编排变量（首次使用前请修改为自定义值）
DB_USER=
DB_PASS=
APP_PORT=4173
# 数据加密密钥（必填）；用于加密数据库中的 API Key，部署后请勿更改
APP_ENCRYPTION_KEY=

# 本地开发数据库连接（Docker 部署时此变量不生效）
DATABASE_URL=postgresql://username:password@127.0.0.1:5432/change-me
DATABASE_POOL_SIZE=10

# ── AI 提供商 ──────────────────────────────────────────────────────
# 数据库 ai_settings 表未配置时的兜底值；留空则需在页面设置中保存
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ── FlyAI 旅行 Skill（机票与酒店）──────────────────────────────────
# 可选增强凭证；留空也可试用基础查询
FLYAI_API_KEY=

# ── MCP 服务（地图、天气、网页搜索）────────────────────────────────
# SearXNG 全能搜索 MCP（需自行部署服务端，可选）
MCP_SEARXNG_URL=

# 高德地图 MCP
AMAP_WEB_SERVICE_KEY=

# Tavily 网页搜索 MCP
TAVILY_API_KEY=

# ── Headroom 上下文压缩代理 ────────────────────────────────────────
# 留空则直连 AI 提供商
# Docker 编排下：http://headroom:8787/v1（配合 --profile headroom 使用）
# 本地开发下：http://127.0.0.1:8787/v1
HEADROOM_PROXY=

# ── 其他 ────────────────────────────────────────────────────────────
# UAPI 天气查询；留空时使用访客额度
UAPI_API_KEY=
