# 方式一（推荐）：飞书开放平台企业自建应用 + 群 chat_id
# 需开通 im:message 权限，并将机器人加入目标群
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=

# 方式二：飞书自定义机器人 Webhook（群设置 → 机器人 → 自定义机器人）
# https://open.feishu.cn/open-apis/bot/v2/hook/<your_key>
# FEISHU_WEBHOOK_URL=

# 自定义机器人「签名校验」密钥（启用签名时必填，仅 webhook 模式）
# FEISHU_WEBHOOK_SECRET=

# 单条消息最大字节数（默认 20000，超长自动分批）
# FEISHU_MAX_BYTES=20000

# 监控完成后推送的报告类型：ranked（TOP3，默认）| latest（全量）| both
FEISHU_REPORT=ranked
