# 飞书自定义机器人 Webhook（群设置 → 机器人 → 自定义机器人）
# https://open.feishu.cn/open-apis/bot/v2/hook/<your_key>
FEISHU_WEBHOOK_URL=

# 目标群 chat_id（oc_ 开头，便于核对机器人是否加在该群）
# FEISHU_CHAT_ID=oc_xxxxxxxx

# 自定义机器人「签名校验」密钥（启用签名时必填）
# FEISHU_WEBHOOK_SECRET=

# 单条消息最大字节数（默认 20000，超长自动分批）
# FEISHU_MAX_BYTES=20000

# 监控完成后推送的报告类型：ranked（TOP3，默认）| latest（全量）
FEISHU_REPORT=ranked
