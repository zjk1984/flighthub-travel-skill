{
  "name": "workspace",
  "version": "1.0.0",
  "description": "OpenClaw Skill，基于飞猪 MCP 接口，提供机票、酒店、门票、景点等一站式旅行搜索能力。",
  "main": "index.js",
  "scripts": {
    "monitor:xinjiang": "bash scripts/monitor-xinjiang.sh",
    "monitor:ranked": "bash scripts/monitor-xinjiang.sh reports/xinjiang-flights-latest.md reports/xinjiang-flights-ranked.md",
    "monitor:outbound": "bash scripts/monitor-xinjiang.sh --phase outbound",
    "monitor:return": "bash scripts/monitor-xinjiang.sh --phase return",
    "monitor:config": "node scripts/monitor-config.js show",
    "monitor:reset": "node scripts/monitor-config.js reset",
    "monitor:set": "node scripts/monitor-config.js set",
    "notify:feishu": "bash -c 'source scripts/load-env.sh && node scripts/feishu-notify.js reports/xinjiang-flights-ranked.md'",
    "setup:feishu": "bash scripts/setup-feishu.sh",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjk1984/flighthub-travel-skill.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/zjk1984/flighthub-travel-skill/issues"
  },
  "homepage": "https://github.com/zjk1984/flighthub-travel-skill#readme",
  "dependencies": {
    "@fly-ai/flyai-cli": "^1.0.16"
  }
}
