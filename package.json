{
  "name": "workspace",
  "version": "1.0.0",
  "description": "OpenClaw Skill，基于飞猪 MCP 接口，提供机票、酒店、门票、景点等一站式旅行搜索能力。",
  "main": "index.js",
  "scripts": {
    "monitor:xinjiang": "bash scripts/monitor-xinjiang.sh",
    "monitor:ranked": "bash scripts/monitor-xinjiang.sh reports/xinjiang-flights-latest.md reports/xinjiang-flights-ranked.md",
    "monitor:outbound": "bash scripts/monitor-outbound.sh",
    "monitor:return": "bash scripts/monitor-return.sh",
    "skill:outbound": "bash scripts/monitor-outbound.sh",
    "skill:return": "bash scripts/monitor-return.sh",
    "skill:custom-outbound": "bash -c 'source scripts/load-env.sh && node scripts/custom-transfer.js --direction outbound reports/xinjiang-results.jsonl && node scripts/format-ranked-report.js reports/xinjiang-results.jsonl --scope outbound > reports/xinjiang-outbound-ranked.md'",
    "monitor:config": "node scripts/monitor-config.js show",
    "monitor:reset": "node scripts/monitor-config.js reset",
    "monitor:set": "node scripts/monitor-config.js set",
    "monitor:preset": "node scripts/monitor-config.js preset",
    "monitor:presets": "node scripts/monitor-config.js list-presets",
    "monitor:hotels": "bash -c 'source scripts/load-env.sh && node scripts/monitor-hotels.js'",
    "monitor:hotels:ranked": "node scripts/format-hotels-ranked.js reports/xinjiang-hotels-latest.json",
    "monitor:resume": "bash -c 'source scripts/load-env.sh && node scripts/monitor-resume.js'",
    "monitor:brief": "node scripts/format-travel-brief.js reports/xinjiang-results.jsonl",
    "notify:feishu": "bash -c 'source scripts/load-env.sh && node scripts/feishu-notify.js reports/xinjiang-flights-brief.md'",
    "notify:feishu:ranked": "bash -c 'source scripts/load-env.sh && node scripts/feishu-notify.js reports/xinjiang-flights-ranked.md'",
    "notify:feishu:test": "bash -c 'source scripts/load-env.sh && node scripts/feishu-notify.js --test'",
    "setup:feishu": "bash scripts/setup-feishu.sh",
    "lvji:dev": "pnpm --dir apps/lvji dev",
    "lvji:build": "pnpm --dir apps/lvji build",
    "lvji:test": "pnpm --dir apps/lvji test",
    "test": "node --test scripts/__tests__/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjk1984/flighthub-travel-skill.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/zjk1984/flighthub-travel-skill/issues"
  },
  "homepage": "https://github.com/zjk1984/flighthub-travel-skill#readme",
  "dependencies": {
    "@fly-ai/flyai-cli": "^1.0.16"
  }
}
